spring:
  datasource:
    url: jdbc:mysql://HOST:PORT/DATABASE
    username: DB_USERNAME
    password: DB_PASSWORD

    hikari:
      maximum-pool-size: 5
      minimum-idle: 2
      idle-timeout: 30000
      connection-timeout: 30000

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    database-platform: org.hibernate.dialect.MySQLDialect
